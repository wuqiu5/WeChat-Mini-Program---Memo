page {
  background-color: #fffde0; /* 淡黄色 */
}

.edit-wrap {
  display: flex; /* 使用弹性盒布局 */
  flex-direction: column; /* 垂直排列子元素 */
  position: relative;
  background: #fff;
  padding: 0rpx;
  margin-top: 15rpx;
  width: 95%; /* 使编辑区域宽度为100% */
}
.switch {
  transform: scale(0.8); /* 适当缩小开关大小 */
  vertical-align: middle; /* 垂直居中对齐 */
}
.ipt-edit {
  border: 1rpx solid #ddd;
  border-radius: 3px;
  padding: 6rpx;
  margin-right: 6rpx;
  font-size: 30rpx;
  width: calc(90% - 5rpx); /* 减去内边距和右边距 */
  margin-bottom: 20rpx;
}
.btn-edit {
  line-height: 60rpx;
  font-size: 24rpx;
  color: #fff;
  height: 60rpx;
  background: #6fa6cf; /* 按钮背景颜色 */
  border: none; /* 无边框 */
  border-radius: 5px; /* 圆角 */
  width: 100rpx; /* 按钮宽度 */
}
 .time-picker-container {
  display: flex; /* 使用弹性盒模型 */
  flex-direction: row; /* 子元素水平排列 */
  justify-content: center; /* 子元素两端对齐 */
  align-items: center; /* 垂直居中对齐 */
  margin-top: 30rpx; /* 增加顶部外边距 */
} 
.flex-time-container {
  display: flex; /* 使用弹性盒布局 */
  flex-direction: column; /* 子元素垂直排列 */
  margin-top: 70rpx; /* 与输入框之间的间距 */
}

.flex-row {
  display: flex; /* 弹性盒模型 */
  margin: 2rpx 0; /* 子元素之间的间距 */
}
.input-wrap {
  margin: 20rpx 30rpx;
  display: flex;
  flex-direction: column; /* 垂直排列子元素 */
  align-items: center; /* 垂直居中对齐 */
}

/* 输入框样式 */
.ipt-main {
  border: 1rpx solid rgb(255, 147, 6);
  border-radius: 5px;
  height: 80rpx;
  padding: 10rpx 15px;
  font-size: 30rpx;
  width: 90%; /* 调整宽度以适应容器 */
  margin-bottom: 20rpx; /* 与时间选择器之间的间距 */
}



