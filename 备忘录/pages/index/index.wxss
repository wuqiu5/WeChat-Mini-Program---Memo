/**index.wxss**/
.header{
  text-align: center;
  font-size: 40rpx;
  color: #ae9e84;
  margin-bottom: 40px;
  width:100%;
  position: relative;
  height:50px;
}
.header::after{
  content:'TODOLIST';
  position: absolute;
  width: 24rem;
  z-index: 1;
  text-align: center;
  color: rgba(225, 225, 225, 0.835);
  font-size: 110rpx;
  left: 0;
  bottom:-55px;
}

.userinfo-nickname {
  color: #a38e6d;
}
/*输入区域*/
/* .input-wrap{  
  margin: 20rpx 30rpx;
} */
.flex-row{
  display: flex;
  margin: 10rpx 0;
  width: 670rpx;
  -webkit-box-pack: justify;
}
 .pick-time{
  flex:2;
  text-align: center;
  margin-right: 10rpx; /* 右边距 */
} 
.time{
  color: #777;
  font-size:12px;
  margin-right: 0rpx; /* 右边距 */
}
.switch{
  transform: scale(0.5);
  vertical-align: middle;
}
 .btn{  
  border-radius: 5px;
  font-size: 30rpx;
  line-height: 100rpx;
  display: block;
  background: #6fa6cf;
} 
.btn-submit{
  color: rgb(252, 250, 250);
  flex: 1;
  margin-right:10rpx;
}
.btn-hover{
  background: #a2c7e2;
}
.btn-cancel{
  background: rgb(253, 253, 253);
}

